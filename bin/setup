#!/usr/bin/env bash
#
# bin/setup — get this app running locally in one command.
# Targets macOS and Linux users comfortable with a terminal.
# Idempotent: safe to re-run.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

bold() { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

bold "AgentC app template — setup"

# 1. Prerequisites ------------------------------------------------------------
command -v crystal >/dev/null || die "Crystal not found → https://crystal-lang.org/install/ (macOS: brew install crystal)"
ok "crystal $(crystal --version | head -1 | awk '{print $2}')"
if ! command -v psql >/dev/null; then
  warn "psql not found. Install & start PostgreSQL, then re-run:"
  warn "  macOS: brew install postgresql@17 && brew services start postgresql@17"
  warn "  Linux: sudo apt install postgresql && sudo service postgresql start"
  die "PostgreSQL is required."
fi
pg_isready >/dev/null 2>&1 && ok "postgresql is up" || warn "psql found but server may be down (brew services start postgresql@17)"

# 2. .env ---------------------------------------------------------------------
if [ ! -f .env ]; then cp .env.example .env; ok "created .env from .env.example"; else ok ".env present"; fi
set -a; [ -f .env ] && . ./.env; set +a

# 3. Dependencies -------------------------------------------------------------
bold "Installing dependencies (shards install)…"
shards install
ok "dependencies installed"

# 4. Databases ----------------------------------------------------------------
APP_SLUG="$(awk '/^name:/{print $2; exit}' shard.yml)"
DBUSER="${DB_USER:-$(whoami)}"
DBHOST="${DB_HOST:-localhost}"
DBPORT="${DB_PORT:-5432}"
DEV_DB="${APP_SLUG}_development"
TEST_DB="${APP_SLUG}_test"

bold "Creating databases…"
for db in "$DEV_DB" "$TEST_DB"; do
  if createdb -h "$DBHOST" -p "$DBPORT" -U "$DBUSER" "$db" 2>/dev/null; then ok "created $db"; else warn "$db already exists (ok)"; fi
done

# 5. Migrations ---------------------------------------------------------------
bold "Running migrations…"
crystal build db/micrate.cr -o bin/micrate
migrate_db() { # migrate_db <db> <env>
  local db="$1" env="$2" out
  if out="$(DB_NAME="$db" APP_ENV="$env" DB_USER="$DBUSER" bin/micrate up 2>&1)"; then
    ok "migrated $db"
  elif echo "$out" | grep -qiE "already exists|no migrations"; then
    ok "$db already up to date"
  else
    warn "migration issue on $db:"; echo "$out" | tail -4
  fi
}
migrate_db "$DEV_DB"  development
migrate_db "$TEST_DB" test

# 6. Seeds (optional) ---------------------------------------------------------
if [ -f db/seeds.cr ]; then
  APP_ENV=development DB_USER="$DBUSER" crystal run db/seeds.cr >/dev/null 2>&1 && ok "seeded $DEV_DB" || warn "seeds skipped (optional)"
fi

bold "Setup complete. Next:"
echo "  bin/server           # start the app, then open http://localhost:3000"
echo "  crystal spec         # run the test suite"
echo "  bin/new-app my_app   # (optional) rename this template to your own app"
