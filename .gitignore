# dependencies & build caches (regenerated by `shards install` / the compiler)
/lib/
/.crystal/
/.shards/
/tmp/
/doc/
/node_modules

# editor / OS
/.vscode/
.DS_Store

# secrets — NEVER commit these (each project generates its own)
.env
.encryption_key
config/environments/.production.enc
production.yml

# build artifacts
/public/dist
/public/javascript/
*.dwarf

# compiled binaries land in bin/, but keep the helper scripts tracked
/bin/*
!/bin/setup
!/bin/server
!/bin/new-app
!bin/spec

# local Claude Code settings
.claude/settings.local.json
