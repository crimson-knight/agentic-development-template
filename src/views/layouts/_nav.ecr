<%- active_home = context.request.path == "/" ? "border-indigo-500 text-gray-900" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" %>
<a href="/" class="<%= active_home %> inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors duration-200">
  Home
</a>
<%- if !logged_in? %>
  <a href="/login" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors duration-200">
    Sign In
  </a>
<%- end %>
