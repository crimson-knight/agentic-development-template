<% if logged_in? %>
  <a href="/dashboard"<% if request.path == "/dashboard" %> aria-current="page"<% end %>>Workspace</a>
  <a href="/settings"<% if request.path == "/settings" || request.path == "/profile" %> aria-current="page"<% end %>>Profile &amp; settings</a>
  <a href="/">View website</a>
<% else %>
  <a href="/">Home</a><a href="/login">Sign in</a>
<% end %>
