<!doctype html>
<html lang="en">
  <head>
    <title>AgentC · Your account</title>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <% if request.path == "/" %><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script><% end %>
    <link rel="stylesheet" href="/css/main.css"><link rel="stylesheet" href="/css/account-workspace.css">
    <link rel="icon" href="/favicon.png">
    <%= FRONT_LOADER.render_import_map_tag %>
    <script type="module">import "account_workspace";</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="<%= logged_in? ? "/dashboard" : "/" %>"><img src="/img/logo.svg" width="32" height="32" alt=""><span>AgentC</span></a>
        <button class="menu-toggle button button-secondary" type="button" aria-controls="account-menu" aria-expanded="false" data-menu-toggle>Menu</button>
        <div id="account-menu" class="header-menu">
          <nav aria-label="Main navigation"><%= render(partial: "layouts/_nav.ecr") %></nav>
          <div class="session-info"><%= render(partial: "layouts/_session.ecr") %></div>
        </div>
      </div>
    </header>
    <main id="main" class="main-content">
      <% flash.each do |key, value| %><div class="notice <%= key == "danger" || key == "error" ? "notice-error" : "notice-success" %>" role="<%= key == "danger" || key == "error" ? "alert" : "status" %>"><%= html_escape(value) %></div><% end %>
      <%= content %>
    </main>
  </body>
</html>
