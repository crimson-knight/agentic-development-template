<%- if logged_in? %>
  <div class="flex items-center space-x-4">
    <span class="text-sm text-gray-700">
      <%= get_current_user.try(&.email) %>
    </span>
    <a href="/profile" class="text-gray-500 hover:text-gray-700 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
      Profile
    </a>
    <a href="/logout" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
      Sign Out
    </a>
  </div>
<%- end %>
