<section class="workspace panel stack narrow" data-component="login-form">
  <header class="page-heading"><p class="eyebrow">Welcome back</p><h1>Sign in</h1><p class="muted">Enter the email and password for your account.</p></header>
  <form class="stack" action="/login" method="post" data-account-form>
    <%= csrf_tag %>
    <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" required></div>
    <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
    <button class="button" type="submit" data-busy-label="Signing in…">Sign in</button>
  </form>
</section>
