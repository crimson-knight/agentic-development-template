<section class="workspace stack" data-component="account-dashboard">
  <header class="page-heading">
    <p class="eyebrow">Your workspace</p>
    <h1>Welcome<%= get_current_user.try(&.display_name.presence).try { |name| ", #{html_escape(name)}" } %></h1>
    <p class="muted">Manage your account and keep your sign-in details up to date.</p>
  </header>
  <div class="workspace-grid">
    <section class="panel stack" aria-labelledby="account-heading">
      <h2 id="account-heading">Your account</h2>
      <dl class="facts">
        <div><dt>Sign-in email</dt><dd><%= html_escape(get_current_user.try(&.email)) %></dd></div>
        <div><dt>Profile name</dt><dd><%= html_escape(get_current_user.try(&.display_name.presence) || "Not set yet") %></dd></div>
      </dl>
      <a class="button" href="/settings">Manage account</a>
    </section>
    <section class="panel stack" aria-labelledby="activity-heading">
      <h2 id="activity-heading">A clear starting point</h2>
      <p class="muted">This template has account tools ready to use. Business activity will appear when your application connects its own workflows.</p>
      <p>No sample revenue, customer counts, or activity is shown as real data.</p>
      <a href="/settings#security">Review sign-in security</a>
    </section>
  </div>
</section>
